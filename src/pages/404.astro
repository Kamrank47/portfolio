---
import Base from "../layouts/Base.astro";
---

<Base
  title="Page not found · Kamran Hashmi"
  description="That page does not exist. The work, stack and CV are one click away."
>
  <div class="wrap notfound">
    <p class="eyebrow">404 · No route matched</p>
    <h1>Nothing<br />deployed here.</h1>
    <p style="color:var(--ink-soft); max-width:40ch">
      The path you asked for does not exist. The work, stack and CV are all still
      one click away.
    </p>
    <div class="hero__actions" style="margin-top:8px">
      <a class="btn btn--primary" href="/">Back to the portfolio</a>
      <a class="btn btn--ghost" href="/resume">View the CV</a>
    </div>
  </div>
</Base>
