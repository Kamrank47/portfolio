---
import Base from "../layouts/Base.astro";
import RunCard from "../components/RunCard.astro";
import ProjectList from "../components/ProjectList.astro";
import {
  profile,
  metrics,
  projectThemes,
  stack,
  experience,
  posts,
  education,
  continuingEducation,
} from "../data/profile";
---

<Base
  title="Kamran Hashmi · DevOps & DevSecOps Engineer"
  description="DevOps and DevSecOps engineer in Lahore. Kubernetes, Terraform, CI/CD, security hardening and observability for teams that need deploys to stop being events."
>
  <section class="hero">
    <div class="wrap hero__grid">
      <div>
        <p class="status-pill">
          <span class="status-pill__dot" aria-hidden="true"></span>
          {profile.availability}
        </p>

        <h1 class="hero__title">
          <span class="line"><span>I make</span></span>
          <span class="line"><span>infrastructure</span></span>
          <span class="line"><span><em>boring</em>.</span></span>
        </h1>

        <p class="hero__lede">
          DevOps and DevSecOps engineer in Lahore. Five years in software, four on
          the platform layer: <strong>Kubernetes</strong> on EKS and AKS,
          <strong>Terraform</strong> and Terragrunt, CI/CD, security hardening, and
          the observability that tells you when any of it breaks.
        </p>

        <div class="hero__actions">
          <a class="btn btn--primary" href={`mailto:${profile.email}`}>
            <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
              <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4Zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2Zm13 2.383-4.708 2.825L15 11.105V5.383Zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741ZM1 11.105l4.708-2.897L1 5.383v5.722Z"/>
            </svg>
            <span>Email me</span>
            <span aria-hidden="true">→</span>
          </a>
          <a class="btn btn--ghost" href="#work">
            <span>Explore platforms</span>
            <span aria-hidden="true">↓</span>
          </a>
          <a class="btn btn--ghost btn--sm mono" href="/resume">
            <svg viewBox="0 0 16 16" width="13" height="13" fill="currentColor" aria-hidden="true">
              <path d="M4 0h5.293A1 1 0 0 1 10 .293l3.707 3.707A1 1 0 0 1 14 4.707V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2zm5.5 1.5v2a1 1 0 0 0 1 1h2l-3-3zM4.5 9a.5.5 0 0 0 0 1h7a.5.5 0 0 0 0-1h-7zM4 11.5a.5.5 0 0 0 .5.5h7a.5.5 0 0 0 0-1h-7a.5.5 0 0 0-.5.5zm.5-5a.5.5 0 0 0 0 1h4a.5.5 0 0 0 0-1h-4z"/>
            </svg>
            <span>Both CVs</span>
          </a>
        </div>

        <dl class="hero__meta">
          <div class="meta-item">
            <dt>Based in</dt>
            <dd>{profile.location}<br />{profile.timezone}</dd>
          </div>
          <div class="meta-item">
            <dt>Experience</dt>
            <dd>5 years<br />4 in DevOps</dd>
          </div>
          <div class="meta-item">
            <dt>Currently</dt>
            <dd>{profile.company}<br />DevOps Engineer</dd>
          </div>
          <div class="meta-item">
            <dt>Focus</dt>
            <dd>DevSecOps<br />MLOps</dd>
          </div>
        </dl>
      </div>

      <div class="hero__aside">
        <RunCard />
        <p class="hero__aside-note">
          <strong>How to read this page.</strong> Every number comes from production
          work at Pikessoft, Northbay or DevSmith. The repositories below are the
          generalized versions, with client details replaced.
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="impact" aria-labelledby="impact-title">
    <div class="wrap">
      <div class="section__head reveal">
        <p class="section__index">01 / Impact</p>
        <div>
          <h2 class="section__title" id="impact-title">
            Infrastructure is judged by what it removes.
          </h2>
          <p class="section__intro">
            Slow deploys, silent failures, surprise bills, credentials in git. Each
            of these was a number I could move.
          </p>
        </div>
      </div>

      <dl class="metrics reveal stagger">
        {metrics.map((metric) => (
          <div class="metric">
            <div class="metric__header">
              <span class="metric__value">
                {metric.value}<span>{metric.unit}</span>
              </span>
              {"trend" in metric && (
                <span class="metric__trend">
                  <span class="metric__trend-num">{metric.trend}</span>
                  <span class="metric__trend-txt">{metric.trendLabel}</span>
                </span>
              )}
            </div>
            <dt class="sr-only">{metric.label}</dt>
            <dd class="metric__body">
              <span class="metric__label">{metric.label}</span>
              <span class="metric__src">{metric.src}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section" id="work" aria-labelledby="work-title">
    <div class="wrap">
      <div class="section__head reveal">
        <p class="section__index">02 / Selected work</p>
        <div>
          <h2 class="section__title" id="work-title">
            Five platforms, one pattern.
          </h2>
          <p class="section__intro">
            Every project here is a production pattern rebuilt as a reference
            implementation: provisioned with code, delivered through a pipeline,
            and proven by what it does under load. Client names and account
            details are replaced with placeholders.
          </p>
        </div>
      </div>

      <div class="themes reveal stagger">
        <span class="eyebrow">Across every project</span>
        <ul class="tags">
          {projectThemes.map((theme) => <li class="tag">{theme}</li>)}
        </ul>
      </div>

      <ProjectList />

      <p class="work-note mono reveal">
        More repositories, including the MLOps coursework:
        <a href={profile.links.github} rel="noopener">{profile.links.github.replace("https://", "")} ↗</a>
      </p>
    </div>
  </section>

  <section class="section" id="stack" aria-labelledby="stack-title">
    <div class="wrap">
      <div class="section__head reveal">
        <p class="section__index">03 / Stack</p>
        <div>
          <h2 class="section__title" id="stack-title">
            Tools I run, not tools I list.
          </h2>
          <p class="section__intro">
            Grouped by the layer they live in. Everything below has been used to
            ship or operate something, except where marked as current study.
          </p>
        </div>
      </div>

      <div class="stack reveal stagger">
        {stack.map((group) => (
          <div class="stack__group">
            <div class="stack__head">
              <h3 class="stack__title">{group.group}</h3>
            </div>
            {"tags" in group && group.tags && (
              <ul class="tags stack__tags">
                {group.tags.map((tag: string) => (
                  <li class="tag tag--tech">{tag}</li>
                ))}
              </ul>
            )}
            <p class="stack__items">{group.items}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="experience" aria-labelledby="experience-title">
    <div class="wrap">
      <div class="section__head reveal">
        <p class="section__index">04 / Experience</p>
        <div>
          <h2 class="section__title" id="experience-title">
            Five years, three teams.
          </h2>
          <p class="section__intro">
            From application code to the platform those applications run on. The
            path matters: I still read the application logs before I touch the
            cluster.
          </p>
        </div>
      </div>

      <div class="timeline reveal stagger">
        {experience.map((job) => (
          <article class="job">
            <div class="job__meta">
              <div class="job__org-row">
                <h3 class="job__org">{job.org}</h3>
                <span class="job__badge">{job.location}</span>
              </div>
              <p class="job__role">{job.role}</p>
              <p class="job__dates">{job.dates}</p>
            </div>
            <ul class="job__points">
              {job.points.map((point) => (
                <li set:html={point} />
              ))}
            </ul>
          </article>
        ))}
      </div>

      <div class="edu reveal">
        <div class="edu__block">
          <p class="eyebrow">Education</p>
          <h3>{education.degree}</h3>
          <p class="edu__meta">{education.school} · {education.year}</p>
          <p class="edu__detail">{education.coursework}</p>
        </div>
        <div class="edu__block">
          <p class="eyebrow">Continuing education</p>
          <h3>{continuingEducation[0].title}</h3>
          <p class="edu__meta">{continuingEducation[0].issuer}</p>
          <p class="edu__detail">
            {continuingEducation[0].detail}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="writing" aria-labelledby="writing-title">
    <div class="wrap">
      <div class="section__head reveal">
        <p class="section__index">05 / Writing</p>
        <div>
          <h2 class="section__title" id="writing-title">Notes from the work.</h2>
          <p class="section__intro">
            The problems that took longer than the documentation suggested. Written
            on Medium, mostly so the next person finds it faster.
          </p>
        </div>
      </div>

      <div class="posts reveal stagger">
        {posts.map((post) => (
          <a class="post" href={post.href} rel="noopener">
            <span class="post__date">{post.date} · {post.read}</span>
            <span class="post__title">{post.title}</span>
            <span class="post__arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>

      <p class="work-note mono reveal">
        <a href={profile.links.medium} rel="noopener">All writing on Medium ↗</a>
      </p>
    </div>
  </section>

  <section class="contact" id="contact" aria-labelledby="contact-title">
    <div class="wrap contact__inner">
      <div class="reveal">
        <p class="eyebrow">06 / Contact</p>
        <h2 id="contact-title" class="mt-16">
          Let’s make your deploys <em>boring</em>.
        </h2>
        <p class="contact__lede">
          Open to remote and contract roles. Based in Lahore, PKT (UTC+5), and
          comfortable writing the runbook as well as the pipeline.
        </p>
        <div class="contact__actions">
          <a class="btn btn--primary" href={`mailto:${profile.email}`}>
            {profile.email}
            <span aria-hidden="true">→</span>
          </a>
          <a class="btn btn--ghost" href={profile.cvs.reference.href} download>Download CV</a>
        </div>
      </div>

      <div class="contact__list reveal">
        <a class="contact__row" href={`mailto:${profile.email}`}>
          <span>Email</span><span>{profile.email}</span>
        </a>
        <a class="contact__row" href={`tel:${profile.phoneHref}`}>
          <span>Phone</span><span>{profile.phone}</span>
        </a>
        <a class="contact__row" href={profile.links.github} rel="noopener">
          <span>GitHub</span><span>Kamrank47</span>
        </a>
        <a class="contact__row" href={profile.links.linkedin} rel="noopener">
          <span>LinkedIn</span><span>in/kamhash</span>
        </a>
        <a class="contact__row" href={profile.links.medium} rel="noopener">
          <span>Medium</span><span>@kamranali.k47</span>
        </a>
      </div>
    </div>
  </section>
</Base>
