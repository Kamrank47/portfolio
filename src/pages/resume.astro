---
import Base from "../layouts/Base.astro";
import { profile, education, continuingEducation } from "../data/profile";
---

<Base
  title="Resume · Kamran Hashmi"
  description="Two versions of Kamran Hashmi's CV: a traditional two-page format for ATS and forwarding, and a modern layout for a first read."
>
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">Resume</p>
      <h1 class="mt-16">Same experience. Two formats.</h1>
      <p>
        The first is the traditional two-page CV, built to survive an applicant
        tracking system and to forward cleanly inside a company. The second is a
        modern layout for the first read. Both say the same thing, because a
        recruiter should never have to compare two stories.
      </p>
      <div class="hero__actions mt-24">
        <a class="btn btn--primary" href={profile.cvs.reference.href} download>
          Download traditional CV
          <span aria-hidden="true">↓</span>
        </a>
        <a class="btn btn--ghost" href={profile.cvs.modern.href} download>
          Download modern CV
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </section>

  <div class="wrap">
    <div class="cv-note" role="note">
      <p>
        <strong>For ATS and forwarding, use the traditional CV.</strong> It is text
        based, single column, no tables, and parses cleanly in Workday, Greenhouse
        and Lever. The modern version is for humans, not parsers.
      </p>
    </div>

    <div class="cv-grid">
      <article class="cv-card reveal">
        <a
          class="cv-card__preview"
          href={profile.cvs.reference.href}
          aria-label="Open the traditional CV in a new tab"
          target="_blank"
          rel="noopener"
        >
          <img
            src="/resume/preview-reference.png"
            alt="Page one of Kamran Hashmi's traditional CV: name, contact details, professional summary, technical skills and professional experience."
            width="1240"
            height="1754"
            loading="lazy"
          />
        </a>
        <div class="cv-card__body">
          <p class="cv-card__tag">Traditional · 2 pages · A4</p>
          <h2>Kamran-Hashmi-CV.pdf</h2>
          <p>
            Centered header, navy section rules, dense experience detail. The version
            to send when a portal asks for a file.
          </p>
          <div class="cv-card__actions">
            <a class="btn btn--sm btn--accent" href={profile.cvs.reference.href} download>
              Download PDF
            </a>
            <a
              class="btn btn--sm btn--ghost"
              href={profile.cvs.reference.href}
              target="_blank"
              rel="noopener"
            >
              Open in new tab
            </a>
          </div>
        </div>
      </article>

      <article class="cv-card reveal">
        <a
          class="cv-card__preview"
          href={profile.cvs.modern.href}
          aria-label="Open the modern CV in a new tab"
          target="_blank"
          rel="noopener"
        >
          <img
            src="/resume/preview-modern.png"
            alt="Page one of Kamran Hashmi's modern CV: name, role, contact details, impact metrics, experience and selected projects."
            width="1240"
            height="1754"
            loading="lazy"
          />
        </a>
        <div class="cv-card__body">
          <p class="cv-card__tag">Modern · 2 pages · A4</p>
          <h2>Kamran-Hashmi-CV-Modern.pdf</h2>
          <p>
            Impact first, then evidence. Numbers up top, project detail under each
            role. The version to send when a person is reading, not a portal.
          </p>
          <div class="cv-card__actions">
            <a class="btn btn--sm btn--accent" href={profile.cvs.modern.href} download>
              Download PDF
            </a>
            <a
              class="btn btn--sm btn--ghost"
              href={profile.cvs.modern.href}
              target="_blank"
              rel="noopener"
            >
              Open in new tab
            </a>
          </div>
        </div>
      </article>
    </div>

    <dl class="resume-facts reveal">
      <div>
        <dt>Current role</dt>
        <dd>{profile.company}, DevOps & DevSecOps Engineer, Aug 2023 to present</dd>
      </div>
      <div>
        <dt>Education</dt>
        <dd>{education.degree}, {education.school}, {education.year}</dd>
      </div>
      <div>
        <dt>Continuing education</dt>
        <dd>{continuingEducation[0].title}, {continuingEducation[0].issuer}</dd>
      </div>
      <div>
        <dt>Contact</dt>
        <dd><a href={`mailto:${profile.email}`}>{profile.email}</a> · <a href={`tel:${profile.phoneHref}`}>{profile.phone}</a></dd>
      </div>
    </dl>
  </div>
</Base>
