---
import Base from "../layouts/Base.astro";
import { profile, education, continuingEducation, certifications } from "../data/profile";
---

<Base
  title="Resume · Kamran Hashmi"
  description="Kamran Hashmi's one-page Classic ATS resume: DevSecOps and AI-safe platform engineering, ready for applicant tracking systems and direct forwarding."
>
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">Resume</p>
      <h1 class="mt-16">One page. Built to parse and read cleanly.</h1>
      <p>
        A single-page Classic ATS resume with clean serif typography, single-column
        structure, and clickable project links. Text-based and free of tables so it
        parses cleanly in Workday, Greenhouse, and Lever while staying fast for a
        hiring manager to scan.
      </p>
      <div class="hero__actions mt-24">
        <a class="btn btn--primary" href={profile.cvs.reference.href} download>
          Download resume
          <span aria-hidden="true">↓</span>
        </a>
        <a
          class="btn btn--ghost"
          href={profile.cvs.reference.href}
          target="_blank"
          rel="noopener"
        >
          Open in new tab
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <div class="wrap">
    <div class="cv-grid">
      <article class="cv-card reveal">
        <a
          class="cv-card__preview"
          href={profile.cvs.reference.href}
          aria-label="Open the resume in a new tab"
          target="_blank"
          rel="noopener"
        >
          <img
            src="/resume/preview-reference.png"
            alt="Kamran Hashmi's one-page Classic ATS resume: contact details, education, experience, technical skills, open source projects, and certifications."
            width="794"
            height="1123"
            loading="lazy"
          />
        </a>
        <div class="cv-card__body">
          <p class="cv-card__tag">Classic ATS · 1 page · A4</p>
          <h2>{profile.cvs.reference.label}</h2>
          <p>
            Single-page serif layout with clean section rules, clickable GitHub and
            portfolio links, and metrics aligned with the work documented on this site.
          </p>
          <ul class="cv-card__points">
            <li>Single A4 page, text-based PDF (no tables or multi-column traps)</li>
            <li>Parses cleanly in Workday, Greenhouse, and Lever</li>
            <li>Clickable links to GitHub repositories, LinkedIn, and portfolio</li>
            <li>Verified metrics and stack matching this site</li>
          </ul>
          <div class="cv-card__actions">
            <a class="btn btn--sm btn--accent" href={profile.cvs.reference.href} download>
              Download PDF
            </a>
            <a
              class="btn btn--sm btn--ghost"
              href={profile.cvs.reference.href}
              target="_blank"
              rel="noopener"
            >
              Open in new tab
            </a>
          </div>
        </div>
      </article>
    </div>

    <dl class="resume-facts reveal">
      <div>
        <dt>Current role</dt>
        <dd>{profile.company}, DevSecOps Engineer, Aug 2023 to present</dd>
      </div>
      <div>
        <dt>Education</dt>
        <dd>{education.degree}, {education.school}, {education.year}</dd>
      </div>
      <div>
        <dt>Certification</dt>
        <dd>{certifications[0].title}, {certifications[0].issuer}</dd>
      </div>
      <div>
        <dt>Continuing education</dt>
        <dd>{continuingEducation[0].title}, {continuingEducation[0].issuer}</dd>
      </div>
      <div>
        <dt>Contact</dt>
        <dd><a href={`mailto:${profile.email}`}>{profile.email}</a> · <a href={`tel:${profile.phoneHref}`}>{profile.phone}</a></dd>
      </div>
    </dl>
  </div>
</Base>
