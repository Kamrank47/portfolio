---
import { run } from "../data/profile";
---

<figure class="run reveal" aria-labelledby="run-caption">
  <div class="run__window-header">
    <div class="run__window-dots" aria-hidden="true">
      <span class="dot dot--red"></span>
      <span class="dot dot--yellow"></span>
      <span class="dot dot--green"></span>
    </div>
    <div class="run__window-title">
      <svg class="run__window-icon" viewBox="0 0 16 16" width="12" height="12" fill="currentColor" aria-hidden="true">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
      </svg>
      <span>deploy-production.yml</span>
    </div>
    <span class="run__commit">{run.id}</span>
  </div>

  <div class="run__bar">
    <div class="run__target-wrap">
      <span class="run__branch-icon" aria-hidden="true">⎇</span>
      <span class="run__target">{run.target}</span>
    </div>
    <span class="run__state">
      <span class="run__beacon" aria-hidden="true"></span>
      {run.state}
    </span>
  </div>

  <ol class="run__stages">
    {run.stages.map((stage, idx) => (
      <li class="stage">
        <span class="stage__status" aria-hidden="true">
          <svg viewBox="0 0 12 12" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="2.5 6 4.8 8.5 9.5 3.5"/>
          </svg>
        </span>
        <span class="stage__body">
          <span class="stage__name">
            <span class="stage__num">{String(idx + 1).padStart(2, "0")}</span>
            {stage.name}
          </span>
          <span class="stage__track">
            <span class="stage__fill"></span>
          </span>
        </span>
        <span class="stage__time">{stage.time}</span>
      </li>
    ))}
  </ol>

  <div class="run__summary">
    <div class="run__total-wrap">
      <span class="run__total-label">Total Time</span>
      <span class="run__total">{run.total}</span>
    </div>
    <span class="run__delta">
      <span class="run__delta-prev">was {run.previous}</span>
      <span class="run__delta-badge">{run.delta}</span>
    </span>
  </div>

  <figcaption class="run__note" id="run-caption">
    <strong>Production Architecture:</strong> {run.note}
  </figcaption>
</figure>
